# Copy this file to .env and fill in your values.
#   cp .env.example .env   (or: copy .env.example .env  on Windows)

# Required for Nominatim geocoding (OSM usage policy requires an e-mail contact)
NOMINATIM_EMAIL=you@example.com

# Serpapi key for live Google Flights data (100 free searches/month)
# Get yours at: https://serpapi.com/
SERPAPI_KEY=

# Set to True to enable live Playwright scraping for hotels/cars
# Requires: playwright install chromium
ENABLE_LIVE_SCRAPING=False

# Optional: override the geocoder cache TTL (seconds). Default is 86400 (24h).
# GEOCODE_CACHE_TTL=86400
